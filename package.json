{
  "name": "kitchen-appliances-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "node scripts/db/engine.mjs generate && next build",
    "start": "next start -p 3005",
    "build:check": "node scripts/build-check.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset -f",
    "db:studio": "prisma studio",
    "db:import": "tsx scripts/scraper/syncToDatabase.ts",
    "catalog:build": "node scripts/catalog/build.mjs",
    "catalog:report": "node scripts/catalog/report.mjs",
    "rag:build": "tsx scripts/rag/buildIndex.ts",
    "rag:test": "tsx scripts/rag/testRetrieval.ts",
    "rag:sync": "tsx scripts/rag/syncProductToRag.ts",
    "chat:test": "tsx scripts/chat/testChat.ts",
    "test": "tsx tests/run-unit.ts && tsx tests/db-url.test.ts",
    "test:e2e": "playwright test",
    "verify:admin": "node scripts/catalog/verify-admin.mjs",
    "verify:auth": "node scripts/catalog/verify-admin-auth.mjs",
    "verify:site": "node scripts/catalog/verify-site.mjs",
    "verify:all": "npm run verify:auth && npm run verify:lockdown && npm run verify:admin && npm run verify:admin-complete && npm run verify:analytics && npm run verify:site && npm run verify:slideshow && npm run verify:ratelimit",
    "verify:slideshow": "node scripts/catalog/verify-slideshow.mjs",
    "verify:admin-complete": "node scripts/catalog/verify-admin-complete.mjs",
    "verify:analytics": "node scripts/catalog/verify-analytics.mjs",
    "verify:ratelimit": "node scripts/catalog/verify-ratelimit.mjs",
    "verify:lockdown": "node scripts/catalog/verify-admin-lockdown.mjs http://localhost:3005 default",
    "demo:reset:dry": "node scripts/catalog/reset-demo-data.mjs",
    "demo:reset": "node scripts/catalog/reset-demo-data.mjs --yes-wipe-enquiries",
    "blob:sync:dry": "node scripts/blob/upload-images.mjs --dry-run",
    "blob:sync": "node scripts/blob/upload-images.mjs",
    "blob:repoint:dry": "node scripts/blob/repoint-static.mjs --dry-run",
    "blob:repoint": "node scripts/blob/repoint-static.mjs",
    "pg:deploy": "node scripts/db/engine.mjs deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@vercel/blob": "^2.6.1",
    "lucide-react": "^0.469.0",
    "next": "^15.5.22",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
