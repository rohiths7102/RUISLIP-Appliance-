// Kitchen Appliances — data layer.
// Local dev uses SQLite; for production switch `provider` to "postgresql" and set
// DATABASE_URL. List/nested fields are modelled as Json so the SAME schema runs on
// both engines (SQLite has no scalar lists/enums). In Postgres you may later convert
// Json list fields to native arrays and RAGDocument.embedding to pgvector.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id                    String    @id @default(cuid())
  sourceUrl             String
  oldUrl                String
  slug                  String    @unique
  title                 String
  brand                 String
  productCode           String
  category              String    @default("")
  subcategory           String    @default("")
  breadcrumbs           Json
  priceNow              Float?
  priceWas              Float?
  saving                Float?
  currency              String    @default("GBP")
  availabilityRaw       String    @default("")
  availabilityNormalised String   @default("call_to_confirm")
  warranty              String    @default("")
  shortDescription      String    @default("")
  descriptionHtml       String    @default("")
  descriptionText       String    @default("")
  specifications        Json
  features              Json
  energyLabelUrl        String    @default("")
  mainImage             String    @default("")
  galleryImages         Json
  relatedProductCodes   Json
  serviceAddOns         Json
  deliveryNotes         String    @default("")
  seoTitle              String    @default("")
  seoDescription        String    @default("")
  lastScrapedAt         DateTime?
  lastUpdatedByAdmin    DateTime?
  /// EAN/GTIN. Google Merchant Center will not return its free price-benchmark
  /// data without one, and it is also the only reliable key for matching the
  /// same appliance across retailers — model codes are formatted inconsistently.
  gtin                  String    @default("")
  /// What the unit costs us, ex-VAT. The ONLY thing that can prove a proposed
  /// price is not below cost; a percentage-drop guard cannot. Never written by
  /// a scrape — see SCRAPE_OWNED in lib/importer.ts.
  costPrice             Float?
  /// Explicit "never advertise below this" override, inc-VAT. When unset the
  /// floor is derived from costPrice + the category's minimum margin.
  floorPrice            Float?
  priceObservations     PriceObservation[]
  isVisible             Boolean   @default(true)
  featured              Boolean   @default(false)
  adminOverrideFields   Json      // field names locked from being overwritten by re-scrape
  categoryRef           Category? @relation(fields: [categoryId], references: [id])
  categoryId            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([productCode])
  @@index([brand])
  @@index([category])
}

model Category {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  sourceUrl      String     @default("")
  parentId       String?
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryTree")
  description    String     @default("")
  image          String     @default("")
  productCount   Int        @default(0)
  order          Int        @default(0)
  isVisible      Boolean    @default(true)
  // Owner-set: products in this category show "Call for price" instead of the
  // price (e.g. accessories Bosch sell at his cost price, coffee machines).
  priceOnApplication Boolean @default(false)
  seoTitle       String     @default("")
  seoDescription String     @default("")
  products       Product[]
}

model Brand {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  sourceUrl    String  @default("")
  logo         String  @default("")
  description  String  @default("")
  productCount Int     @default(0)
  isVisible    Boolean @default(true)
  // Display rank on /brands — the owner's main brands pin first (low = first).
  order        Int     @default(100)
  requiresLogoPermissionReview Boolean @default(true)
}

model BusinessInfo {
  id                     String   @id @default("business") // single-row singleton
  businessName           String
  tradingName            String   @default("")
  phone                  String
  email                  String   @default("")
  address                Json
  openingHours           Json
  deliveryRadius         String   @default("")
  deliveryNotes          String   @default("")
  socialLinks            Json
  services               Json
  mapQuery               String   @default("")
  googleMapsEmbedUrl     String   @default("")
  googleMapsDirectionsUrl String  @default("")
  // Trading disclosures. Companies Act 2006 s.82/s.1202 (SI 2015/17 reg 25)
  // requires a limited company to give its registered number, place of
  // registration and registered office on its website; the E-Commerce
  // Regulations 2002 reg 6 requires the VAT number of a VAT-registered trader.
  // Every one defaults to empty and every render site omits the line when
  // blank — a WRONG company or VAT number on a live site is worse than none,
  // so these are only ever filled in by the owner in the admin.
  companyNumber          String   @default("")
  placeOfRegistration    String   @default("")
  registeredOffice       String   @default("")
  vatNumber              String   @default("")
  updatedAt              DateTime @updatedAt
}

/// A place prices come from. `authorised` means we are entitled to the data
/// (our own supplier/buying group, a licensed feed) and it may — with a floor —
/// be allowed to auto-apply. `advisory` is somebody else's retail price on
/// somebody else's cost base and may NEVER auto-apply, only inform a human.
model PriceSource {
  id             String   @id                   // "euronics", "cih", "google-benchmark"
  label          String
  kind           String   @default("advisory")  // "authorised" | "advisory"
  /// Are the prices this source reports VAT-inclusive? Retail = true, trade = false.
  /// Getting this wrong over-prices by 20%, so it is explicit per source, never guessed.
  priceIncludesVat Boolean @default(true)
  allowAutoApply Boolean  @default(false)
  enabled        Boolean  @default(true)
  lastRunAt      DateTime?
  lastRunStatus  String   @default("")
  observations   PriceObservation[]
  createdAt      DateTime @default(now())
}

/// One price seen at one source at one moment. Append-only: history is what makes
/// a trend visible and lets a bad scrape be spotted rather than silently applied.
model PriceObservation {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceId      String
  source        PriceSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// Headline price as shown by the source, in GBP.
  price         Float?
  /// Delivery, where the source states it. null means UNKNOWN, not free — the
  /// guards refuse to auto-apply on unknown delivery rather than treat it as 0.
  deliveryCost  Float?
  inStock       Boolean?
  /// Copied from the source at observation time so a later config change cannot
  /// retro-reinterpret an old row.
  includesVat   Boolean     @default(true)
  sourceUrl     String      @default("")
  /// How confident we are this really is the same product. Anything below 1.0
  /// came from fuzzy matching and is held for human confirmation.
  matchConfidence Float     @default(0)
  /// "ok" | "blocked" | "not_found" | "parse_failed" — a failed run is recorded,
  /// never silently dropped, or a dead scraper looks identical to stable prices.
  status        String      @default("ok")
  note          String      @default("")
  observedAt    DateTime    @default(now())

  @@index([productId, observedAt])
  @@index([sourceId, observedAt])
}

model ServiceAddOn {
  id               String  @id @default(cuid())
  name             String
  description      String  @default("")
  price            Float?
  optional         Boolean @default(true)
  appliesToCategory String @default("")
  sourceUrl        String  @default("")
}

model AdminAuditLog {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String
  action        String
  changedFields Json
  previousValue Json
  newValue      Json
  changedBy     String
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
}

model ScrapeJob {
  id              String    @id @default(cuid())
  status          String    @default("pending") // pending|running|completed|failed
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  pagesFound      Int       @default(0)
  pagesScraped    Int       @default(0)
  productsFound   Int       @default(0)
  productsCreated Int       @default(0)
  productsUpdated Int       @default(0)
  productsFailed  Int       @default(0)
  errors          Json
  reportPath      String    @default("")
}

model RAGDocument {
  id         String   @id @default(cuid())
  sourceType String   // product|category|brand|business|service|page|faq
  sourceId   String
  title      String
  content    String
  metadata   Json
  embedding  Json     // float[] as JSON now; pgvector in production
  needsReindex Boolean @default(false)
  updatedAt  DateTime @updatedAt

  @@index([sourceType, sourceId])
}

// First-party, anonymous analytics: which products people call about, and where
// they are (postcode checks). No cookies, no IP addresses, no user identifiers —
// just the event, so the owner can see demand without a GDPR headache.
model TrackedEvent {
  id          String   @id @default(cuid())
  type        String   // call_click | postcode_check
  path        String   @default("")
  productSlug String   @default("")
  postcode    String   @default("")
  isLocal     Boolean?
  // Where the visitor's session came from: "google-ads" when they landed with
  // gclid/gbraid/wbraid or cpc UTMs, another utm_source verbatim, else "".
  // Lets the Ads page show which calls the owner's ad spend actually produced.
  source      String   @default("")
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
}

model Enquiry {
  id           String   @id @default(cuid())
  productCode  String   @default("")
  productTitle String   @default("")
  name         String
  email        String   @default("")
  phone        String   @default("")
  message      String
  source       String   @default("product") // product|contact
  // Sales pipeline: new -> contacted -> quoted -> won|lost ("closed" is the
  // legacy pre-pipeline value; the UI reads it as won).
  status       String   @default("new")
  notes        String   @default("")   // the owner's own words, never AI-written
  quotedPrice  Float?                  // what the owner offered — powers pipeline value
  lastEmailedAt DateTime?
  // Last AI-drafted email, cached so a half-edited draft survives a page reload.
  aiDraftSubject String @default("")
  aiDraftBody    String @default("")
  createdAt    DateTime @default(now())

  @@index([status])
}
