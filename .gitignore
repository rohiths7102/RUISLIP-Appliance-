node_modules
.next
dist
.env
.env*.local
*.log
.DS_Store

# Customer enquiries captured by the contact form — real personal data, never commit.
data/enquiries.jsonl

# 2.5GB of extracted catalogue imagery; regenerate from the catalog zips.
# EXCEPTION: the ~2k images the live DB actually references ARE tracked (force-added)
# so the deployment serves them itself — the Vercel Blob store they used to live on
# was suspended (free-tier usage) and 403'd every product photo. To move back to
# Blob later: npm run blob:sync (inverse: npm run blob:repoint).
public/catalog/

# build:check output (see scripts/build-check.mjs)
.next-check/

# Admin-uploaded product photos
public/uploads/

# Local SQLite database
prisma/*.db
prisma/*.db-journal

# Generated from schema.prisma by scripts/db/engine.mjs — never hand-edited
prisma/schema.postgres.prisma

# Isolated Postgres client for the maintenance scripts (PRISMA_CLIENT_DIR);
# regenerate with `node scripts/db/engine.mjs client:pg`
.prisma-pg/

# Catalogue import intermediates — staged.json can be tens of MB and blob-map.json
# pins live Blob URLs; both are per-drop working files, not repo content.
staged.json
blob-map.json

# TypeScript incremental build cache
tsconfig.tsbuildinfo

.vercel
.env*
