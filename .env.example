# Local dev: file:./dev.db (SQLite). Production (Vercel): the Supabase Postgres
# "Transaction pooler" URI — scripts/db/engine.mjs picks the engine automatically.
DATABASE_URL=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Production storage (Vercel) ---
# Vercel Blob write token (Storage -> your store -> .env.local tab). Enables
# admin photo uploads on serverless + `npm run blob:sync` for catalogue images.
BLOB_READ_WRITE_TOKEN=
# Supabase Postgres URI used ONCE by `npm run pg:deploy` to push the schema and
# seed the catalogue. Same value then goes into Vercel as DATABASE_URL.
SUPABASE_DB_URL=

# --- Admin auth ---
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Signs the admin session cookie. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Admin lockdown (see SECURITY.md) ---
# Move the admin off /admin to a secret segment (obscurity, not security).
# e.g. ADMIN_PATH=manage-8f3a2  ->  panel lives at /manage-8f3a2/signin
ADMIN_PATH=
# The REAL "not publicly available" control: only these IPs can reach the admin
# (everyone else gets 404). Comma-separated; exact IPs or prefixes ("203.0.113.").
# Leave empty to disable (demo/dev). Unless you are on Vercel this needs
# TRUST_PROXY_HEADER set too: an IP the app cannot resolve is never on the
# allowlist, so the list would 404 you out of your own admin.
ADMIN_ALLOWED_IPS=

# Which header carries the real client IP — used by the allowlist above and by
# every rate limit. lib/client-ip.ts trusts, in order: this header (rightmost
# value), then Vercel's x-vercel-forwarded-for. Raw x-forwarded-for, x-real-ip
# and cf-connecting-ip are client-supplied and are never believed on their own,
# so name only the header YOUR proxy rewrites:
#   cf-connecting-ip   behind a Cloudflare tunnel / proxy
#   x-forwarded-for    behind your own nginx
# Empty is correct on Vercel only. Anywhere else it means every visitor shares
# one rate-limit bucket and ADMIN_ALLOWED_IPS can never match — the app warns
# once in the log when it happens.
TRUST_PROXY_HEADER=

# --- Enquiry email alerts (optional) ---
# Resend API key (free account at resend.com) — leave empty to disable alerts.
RESEND_API_KEY=
# Where new-enquiry emails go, e.g. the shop inbox.
ENQUIRY_NOTIFY_TO=
# Sender; defaults to Resend's onboarding address — verify a domain later for your own.
ENQUIRY_FROM_EMAIL=

# --- Analytics ---
# GA4 measurement ID (G-XXXXXXXXXX). Leave empty = no analytics, no banner, no cookies.
NEXT_PUBLIC_GA_ID=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
SCRAPER_BASE_URL=https://www.kitchen-appliances.co.uk/
SCRAPER_CONCURRENCY=1
SCRAPER_RESPECT_ROBOTS=true
